{
  "name": "leads-backend",
  "version": "1.0.0",
  "description": "AI Lead Generation Platform Backend",
  "main": "src/index.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --check src/",
    "format:fix": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "docker:build": "docker build -t leads-backend .",
    "docker:run": "docker run -p 8000:8000 --env-file .env leads-backend",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d"
  },
  "keywords": [
    "ai",
    "lead-generation",
    "sales",
    "automation",
    "scraper",
    "browser-automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.8",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.6.0",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "compression": "^1.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.1.1",
    "helmet": "^8.0.1",
    "jsonwebtoken": "^9.0.2",
    "kue": "^0.11.0",
    "lodash": "^4.17.21",
    "minio": "^8.0.7",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.0",
    "puppeteer": "^22.15.0",
    "redis": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.33.5",
    "sqlite3": "latest",
    "swagger-ui-express": "^5.0.1",
    "swagger-jsdoc": "^6.2.8",
    "ts-node-dev": "^2.0.0",
    "winston": "^3.14.0"
  },
"devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "latest",
    "@types/jest": "latest",
    "@types/lodash": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/sharp": "^0.32.0",
    "@types/sqlite3": "^3.0.5",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.2",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.9.1",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
}
}
