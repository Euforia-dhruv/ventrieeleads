{
  "name": "leads-backend",
  "version": "1.0.0",
  "description": "AI Lead Generation Platform Backend",
  "main": "src/index.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --check src/",
    "format:fix": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "docker:build": "docker build -t leads-backend .",
    "docker:run": "docker run -p 8000:8000 --env-file .env leads-backend",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d"
  },
  "keywords": [
    "ai",
    "lead-generation",
    "sales",
    "automation",
    "scraper",
    "browser-automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/ms": "^2.1.0",
    "axios": "^1.7.8",
    "bcryptjs": "^3.0.3",
    "compression": "^1.0.1",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.1.1",
    "helmet": "^8.0.1",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "pg": "^8.13.0",
    "redis": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "uuid": "^8.3.2",
    "winston": "^3.14.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "latest",
    "@types/jest": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.2",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.9.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
